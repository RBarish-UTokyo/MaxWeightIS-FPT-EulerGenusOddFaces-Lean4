module

public import Mathlib.Algebra.Group.Hom.Basic
public import Mathlib.Algebra.Order.Group.Unbundled.Int
public import Mathlib.Logic.Relation
public import Mathlib.Data.Int.Basic
public import Mathlib.Tactic.Abel
public import Mathlib.Tactic.Ring

/-!
# Integral signed incidence

A matrix with two signed unit port occurrences in each row has cokernel with
torsion exponent at most two. An odd integer rounding map proves this directly,
including loops and coincident ports, without choosing a spanning forest.
-/

@[expose] public section

namespace MWIS.SignedIncidence

/-- The odd sum of the lower and upper integer quotients by `n`. -/
def doubleRound (n x : ℤ) : ℤ := x / n - (-x) / n

theorem doubleRound_neg (n x : ℤ) : doubleRound n (-x) = -doubleRound n x := by
  simp [doubleRound]

/-- Translation by a whole period changes the rounded value by twice that period. -/
theorem doubleRound_add_mul (n x z : ℤ) (hn : n ≠ 0) :
    doubleRound n (x + n * z) = doubleRound n x + 2 * z := by
  unfold doubleRound
  rw [show -(x + n * z) = -x + n * (-z) by ring,
    Int.add_mul_ediv_left x z hn, Int.add_mul_ediv_left (-x) (-z) hn]
  ring

/-- A pair whose sum is an integer multiple of the period rounds exactly. -/
theorem doubleRound_pair (n x y z : ℤ) (hn : n ≠ 0) (h : x + y = n * z) :
    doubleRound n x + doubleRound n y = 2 * z := by
  have hy : y = -x + n * z := by omega
  rw [hy, doubleRound_add_mul _ _ _ hn, doubleRound_neg]
  ring

/-- Multiplication by the sign encoded by a Boolean. -/
def signed (positive : Bool) (x : ℤ) : ℤ := if positive then x else -x

@[simp] theorem signed_add (s : Bool) (x y : ℤ) :
    signed s (x + y) = signed s x + signed s y := by
  cases s <;> simp [signed, add_comm]

@[simp] theorem signed_zero (s : Bool) : signed s 0 = 0 := by
  cases s <;> rfl

@[simp] theorem doubleRound_signed (n : ℤ) (s : Bool) (x : ℤ) :
    doubleRound n (signed s x) = signed s (doubleRound n x) := by
  cases s <;> simp [signed, doubleRound_neg]

/-- A signed incidence matrix specified by its two port occurrences per row.
The two vertices may coincide and both signs may be equal. -/
structure Matrix (E V : Type*) where
  first : E → V
  second : E → V
  firstPositive : E → Bool
  secondPositive : E → Bool

/-- The additive map defined by signed incidence. -/
def Matrix.map {E V : Type*} (A : Matrix E V) : (V → ℤ) →+ (E → ℤ) where
  toFun x e := signed (A.firstPositive e) (x (A.first e)) +
    signed (A.secondPositive e) (x (A.second e))
  map_zero' := by ext e; simp
  map_add' x y := by ext e; simp only [Pi.add_apply, signed_add]; abel

/-- Odd quotient rounding gives an explicit witness that every torsion class
in the cokernel of signed incidence is killed by two. -/
theorem two_torsion_cokernel {E V : Type*} (A : Matrix E V)
    (h : E → ℤ) (n : ℕ) (hn : 0 < n)
    (hx : ∃ x, A.map x = n • h) : ∃ x, A.map x = 2 • h := by
  obtain ⟨x, hx⟩ := hx
  refine ⟨fun v => doubleRound n (x v), ?_⟩
  ext e
  have he : signed (A.firstPositive e) (x (A.first e)) +
      signed (A.secondPositive e) (x (A.second e)) = (n : ℤ) * h e := by
    simpa only [Matrix.map, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Pi.smul_apply,
      nsmul_eq_mul] using congrFun hx e
  change signed (A.firstPositive e) (doubleRound n (x (A.first e))) +
      signed (A.secondPositive e) (doubleRound n (x (A.second e))) = _
  rw [← doubleRound_signed, ← doubleRound_signed,
    doubleRound_pair _ _ _ _ (by exact_mod_cast (Nat.ne_of_gt hn)) he]
  simp only [Pi.smul_apply, nsmul_eq_mul, Nat.cast_ofNat]

/-- Undirected connectivity generated by the two ports of each row. -/
def Matrix.Connected {E V : Type*} (A : Matrix E V) : Prop :=
  ∀ u v, Relation.EqvGen (fun a b => ∃ e, A.first e = a ∧ A.second e = b) u v

/-- Along a connected signed incidence graph, two kernel vectors have the
same relative sign at any pair of vertices. -/
theorem kernel_pair_sign {E V : Type*} (A : Matrix E V) (hA : A.Connected)
    (x y : V → ℤ) (hx : A.map x = 0) (hy : A.map y = 0) (u v : V) :
    (x u = x v ∧ y u = y v) ∨ (x u = -x v ∧ y u = -y v) := by
  have h := hA u v
  induction h with
  | rel a b h =>
      obtain ⟨e, rfl, rfl⟩ := h
      have he₁ := congrFun hx e
      have he₂ := congrFun hy e
      change signed (A.firstPositive e) (x (A.first e)) +
        signed (A.secondPositive e) (x (A.second e)) = 0 at he₁
      change signed (A.firstPositive e) (y (A.first e)) +
        signed (A.secondPositive e) (y (A.second e)) = 0 at he₂
      cases hs : A.firstPositive e <;> cases ht : A.secondPositive e <;>
        simp [signed, hs, ht] at he₁ he₂ <;> omega
  | refl a => exact Or.inl ⟨rfl, rfl⟩
  | symm a b _ ih => rcases ih with h | h <;> omega
  | trans a b c _ _ ih₁ ih₂ => rcases ih₁ with h | h <;> rcases ih₂ with h' | h' <;> omega

@[simp] theorem signed_mul (s : Bool) (x y : ℤ) :
    signed s (x * y) = signed s x * y := by
  cases s <;> simp [signed]

/-- A connected signed incidence matrix has either trivial integer kernel or
a kernel generated over the integers by one vector with every coordinate a
unit. This includes a component consisting of one isolated vertex. -/
theorem kernel_zero_or_unit_generator {E V : Type*} (A : Matrix E V)
    (hA : A.Connected) :
    (∀ x, A.map x = 0 → x = 0) ∨
      ∃ g : V → ℤ, (∀ v, g v = 1 ∨ g v = -1) ∧ A.map g = 0 ∧
        ∀ x, A.map x = 0 → ∃ z : ℤ, x = z • g := by
  classical
  by_cases hzero : ∀ x, A.map x = 0 → x = 0
  · exact Or.inl hzero
  · right
    push Not at hzero
    obtain ⟨b, hb, hbne⟩ := hzero
    have hroot : ∃ r, b r ≠ 0 := by
      by_contra h
      push Not at h
      exact hbne (funext h)
    obtain ⟨r, hr⟩ := hroot
    let g : V → ℤ := fun v => if b v = b r then 1 else -1
    have hcoord : ∀ x, A.map x = 0 → ∀ v, x v = g v * x r := by
      intro x hx v
      have h := kernel_pair_sign A hA x b hx hb v r
      dsimp [g]
      split_ifs with hvr
      · rcases h with h | h
        · simpa using h.1
        · exfalso; omega
      · rcases h with h | h
        · exact (hvr h.2).elim
        · simpa using h.1
    have hgb : ∀ v, b v = g v * b r := hcoord b hb
    have hg : A.map g = 0 := by
      ext e
      change signed (A.firstPositive e) (g (A.first e)) +
        signed (A.secondPositive e) (g (A.second e)) = 0
      have he := congrFun hb e
      change signed (A.firstPositive e) (b (A.first e)) +
        signed (A.secondPositive e) (b (A.second e)) = 0 at he
      rw [hgb (A.first e), hgb (A.second e), signed_mul, signed_mul, ← add_mul] at he
      exact (mul_eq_zero.mp he).resolve_right hr
    refine ⟨g, ?_, hg, ?_⟩
    · intro v
      simp only [g]
      split_ifs <;> simp
    · intro x hx
      refine ⟨x r, ?_⟩
      ext v
      simpa [Pi.smul_apply, zsmul_eq_mul, mul_comm] using hcoord x hx v

/-- Unsigned incidence has two positive port occurrences in each row. -/
def Matrix.Unsigned {E V : Type*} (A : Matrix E V) : Prop :=
  (∀ e, A.firstPositive e = true) ∧ (∀ e, A.secondPositive e = true)

/-- Coordinate evaluation for unsigned incidence. -/
theorem unsigned_apply {E V : Type*} (A : Matrix E V) (hA : A.Unsigned)
    (x : V → ℤ) (e : E) : A.map x e = x (A.first e) + x (A.second e) := by
  simp [Matrix.map, signed, hA.1, hA.2]

/-- The parity of a potential whose incidence vector is even is constant
on each connected component. -/
theorem parity_constant_of_even {E V : Type*} (A : Matrix E V)
    (hA : A.Connected) (hs : A.Unsigned) (q : V → ℤ)
    (heven : ∀ e, 2 ∣ A.map q e) (u v : V) : q u % 2 = q v % 2 := by
  have hc := hA u v
  induction hc with
  | rel a b h =>
      obtain ⟨e, rfl, rfl⟩ := h
      obtain ⟨k, hk⟩ := heven e
      rw [unsigned_apply A hs] at hk
      omega
  | refl a => rfl
  | symm a b _ ih => exact ih.symm
  | trans a b c _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- In a connected unsigned graph, an edge vector whose double is an
incidence vector is itself an incidence vector or differs from one by the
all-one edge vector. -/
theorem half_incidence_or_shift {E V : Type*} (A : Matrix E V)
    (hA : A.Connected) (hs : A.Unsigned) (root : V) (h : E → ℤ)
    (hq : ∃ q, A.map q = 2 • h) :
    (∃ x, A.map x = h) ∨ (∃ x, A.map x = h - (fun _ => 1)) := by
  obtain ⟨q, hq⟩ := hq
  have he : ∀ e, q (A.first e) + q (A.second e) = 2 * h e := by
    intro e
    simpa only [unsigned_apply A hs, Pi.smul_apply, nsmul_eq_mul, Nat.cast_ofNat]
      using congrFun hq e
  have hev : ∀ e, 2 ∣ A.map q e := by
    intro e
    refine ⟨h e, ?_⟩
    simpa only [unsigned_apply A hs] using he e
  have hp : ∀ v, q v % 2 = q root % 2 :=
    fun v => parity_constant_of_even A hA hs q hev v root
  have hroot : q root % 2 = 0 ∨ q root % 2 = 1 := by omega
  rcases hroot with hroot | hroot
  · left
    refine ⟨fun v => q v / 2, ?_⟩
    ext e
    rw [unsigned_apply A hs]
    have h₁ := hp (A.first e)
    have h₂ := hp (A.second e)
    have he' := he e
    omega
  · right
    refine ⟨fun v => q v / 2, ?_⟩
    ext e
    rw [unsigned_apply A hs]
    change q (A.first e) / 2 + q (A.second e) / 2 = h e - 1
    have h₁ := hp (A.first e)
    have h₂ := hp (A.second e)
    have he' := he e
    omega

/-- The torsion subgroup of the cokernel of connected unsigned incidence has
at most two elements: zero and the class of the all-one edge vector. -/
theorem torsion_incidence_or_shift {E V : Type*} (A : Matrix E V)
    (hA : A.Connected) (hs : A.Unsigned) (root : V) (h : E → ℤ)
    (n : ℕ) (hn : 0 < n) (hx : ∃ x, A.map x = n • h) :
    (∃ x, A.map x = h) ∨ (∃ x, A.map x = h - (fun _ => 1)) :=
  half_incidence_or_shift A hA hs root h (two_torsion_cokernel A h n hn hx)

/-- A two-coloring of the graph whose port occurrences specify the matrix. -/
def Matrix.Bipartite {E V : Type*} (A : Matrix E V) : Prop :=
  ∃ color : V → Bool, ∀ e, color (A.first e) ≠ color (A.second e)

/-- An integral potential with all edge sums equal to one gives a two-coloring
by the parity of its entries. -/
theorem bipartite_of_one_in_range {E V : Type*} (A : Matrix E V)
    (hs : A.Unsigned) (hx : ∃ x, A.map x = (fun _ => 1)) : A.Bipartite := by
  obtain ⟨x, hx⟩ := hx
  refine ⟨fun v => decide (x v % 2 = 0), ?_⟩
  intro e hcolor
  have he : x (A.first e) + x (A.second e) = 1 := by
    simpa only [unsigned_apply A hs] using congrFun hx e
  have hp : (x (A.first e) % 2 = 0) ↔ (x (A.second e) % 2 = 0) := by
    simpa using hcolor
  omega

/-- In a nonbipartite graph the all-one edge vector is not an integer
incidence vector, so its cokernel class is nonzero. -/
theorem one_not_in_range {E V : Type*} (A : Matrix E V)
    (hs : A.Unsigned) (hn : ¬ A.Bipartite) :
    ¬ ∃ x, A.map x = (fun _ => 1) :=
  fun hx => hn (bipartite_of_one_in_range A hs hx)

end MWIS.SignedIncidence

